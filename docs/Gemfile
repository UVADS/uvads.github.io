source "https://rubygems.org"

# Local preview only. GitHub Pages builds this site itself and ignores this
# file. The Just the Docs theme is fetched at build time via `remote_theme` in
# _config.yml, so it is not listed here.
#
# Note: the `github-pages` gem pins Jekyll 3.9, which will not run on Ruby 3.4+.
# These gems are the modern equivalents of what Pages builds with.
gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-remote-theme"
  gem "jekyll-seo-tag"
  gem "jekyll-include-cache"
  gem "jekyll-sitemap"
end

gem "webrick", "~> 1.8"
